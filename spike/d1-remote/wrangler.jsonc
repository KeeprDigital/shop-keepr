{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "shop-keepr-d1-remote-spike",
	"main": "worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"limits": { "cpu_ms": 30000 },
	"observability": { "enabled": false },
	"d1_databases": [
